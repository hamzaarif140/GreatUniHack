# Copy this file to .env, which git ignores. Next.js and the class server both read it.

# Browser: where the class server is. This is the default.
NEXT_PUBLIC_MEETING_WS_URL=ws://localhost:4000

# Server: set a key to make students live. Without one, they use scripted lines.
# These values stay on the server. Never give them a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=

# Server: set a key for live transcription and student voices. Without one, the
# browser's own speech recognition and voices are used.
ELEVENLABS_API_KEY=

# Optional server settings, shown with their defaults.
# AGENT_MODEL=claude-opus-5-5   # claude-haiku-5-5 replies fastest
# AGENT_ENGINE=auto             # auto, claude or scripted
# AGENT_EFFORT=low              # low, medium, high, xhigh or max
# AGENT_MAX_TURNS=200           # model calls allowed per class
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_MARCUS=      # a voice id; likewise _PRIYA, _LEO, _ANA and _SAMIRA
# PORT=4000
# HOST=127.0.0.1
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
